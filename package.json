{
  "name": "dsh-connect-miaoshou",
  "displayName": "DSH Connect Miaoshou",
  "description": "把本机已登录的妙手（美团 CatPaw / catpaw-moon）桌面客户端接入 DeepSeek Harness：复用其 passport 登录态，走 nocode.cn 的 chat/agent-stream 链路，提供 12 个模型（LongCat / GLM / Kimi / DeepSeek / MiniMax），外加一块只读积分看板。",
  "version": "0.1.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wahwayhale/dsh-connect-miaoshou.git"
  },
  "homepage": "https://github.com/Wahwayhale/dsh-connect-miaoshou#readme",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "miaoshou",
    "catpaw",
    "model-provider"
  ],
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "docs/assets"
  ],
  "scripts": {
    "prepack": "npm run build",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "check": "npm run typecheck && npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1-rc.1 <5.0.0 || >=4.0.2 <5.0.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.1.7-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.1-rc.1 <4.0.0 || >=3.18.2 <4.0.0",
    "@earendil-works/pi-ai": ">=0.85.0 <0.88.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "bugs": {
    "url": "https://github.com/Wahwayhale/dsh-connect-miaoshou/issues"
  }
}
